# Dependencies (restore with `npm install`)
node_modules/

# Build / test output
dist/
coverage/

# Other env variants stay ignored. NOTE: `.env` itself is deliberately NOT
# ignored in this repo (owner's decision), so it is committed with DATABASE_URL.
# Keep this repository private.
.env.*

# SQLite runtime side files (the database itself, data/app.db, is committed)
*.db-wal
*.db-shm

# Logs, OS / editor files
*.log
.DS_Store
.vscode/
.idea/
